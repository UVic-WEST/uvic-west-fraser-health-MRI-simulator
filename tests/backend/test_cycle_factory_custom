def test_update_cycle_with_actions(factory, temp_json):
    actions = [
        {
            "timestamp_ms": 0,
            "action_type": "SOUND_START",
            "parameters": {"file_name": "test.wav", "volume": 50}
        }
    ]
    factory.update_cycle(1, {"actions": actions})

    data = json.loads(temp_json.read_text())
    cycle = next(c for c in data if c["id"] == 1)
    assert cycle["actions"] == actions


def test_update_nonexistent_cycle_raises(factory):
    with pytest.raises(ValueError):
        factory.update_cycle(999, {"name": "No Such Cycle"})


def test_add_cycle_and_persist(factory, temp_json):
    new_cycle = CycleConfig(3, "New Cycle", 8000, 40)
    factory.add_cycle(new_cycle)

    data = json.loads(temp_json.read_text())
    ids = [c["id"] for c in data]
    assert 3 in ids